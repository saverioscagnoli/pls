{
  "$schema": "./config.schema.new.json",
  "palette": {
    "blue": "#89b4fa",
    "teal": "#94e2d5",
    "text": "#cdd6f4",
    "overlay2": "#9399b2",
    "overlay0": "#6c7086",
    "green": "#a6e3a1",
    "mauve": "#cba6f7",
    "red": "#f38ba8",
    "yellow": "#f9e2af",
    "peach": "#fab387"
  },
  "ls": {
    "columns": [
      {
        "header": "Name",
        "format": "{icon}  {name}"
      },
      {
        "header": "Permissions",
        "format": "{permissions}"
      },
      {
        "header": "Owner",
        "format": "{owner}"
      },
      {
        "header": "Size",
        "format": "{size>}"
      },
      {
        "header": "Modified",
        "format": "{modified>}"
      }
    ],
    "modified_fmt": "%d %b %H:%M",
    "icons": {
      "default": "",
      "names": {
        "Desktop": "",
        "Downloads": "",
        "Templates": "",
        "Public": "",
