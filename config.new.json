        "ppt pptx": "",
        "png jpg jpeg gif webp bmp ico": "",
        "svg": "󰜡",
        "mp3 flac wav ogg": "",
        "mp4 mkv webm mov": "",
        "zip tar gz xz zst 7z rar deb rpm": "",
