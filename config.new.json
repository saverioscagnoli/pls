    "file_styles": {
      "default": "text",
      "icon_default": "overlay2",
      "kinds": {
        "directory": "blue bold",
        "symlink_directory": "teal bold italic",
        "symlink_file": "teal italic",
        "broken_symlink": "red strikethrough",
        "executable": "green bold"
      },
      "extensions": {
        "png jpg jpeg gif webp bmp ico svg mp3 flac wav ogg mp4 mkv webm mov": "mauve",
        "zip tar gz xz zst 7z rar deb rpm iso img": "red",
        "md txt pdf doc docx": "yellow",
        "json jsonc toml yaml yml ini conf cfg lock": "peach"
      }
    },
    "styles": {
      "permissions": "overlay0",
      "owner": "yellow",
      "group": "peach",
      "size": {
        "default": "green",
        "kinds": {
          "directory": "overlay0 dim"
        }
      },
      "modified": "mauve",
      "nlink": "overlay0"
