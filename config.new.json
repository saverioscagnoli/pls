        "tsx jsx": "",
        "go": "",
        "c h": "",
        "cpp cc hpp": "",
        "java": "",
        "kt": "",
        "rb": "",
        "php": "",
        "lua": "",
        "zig": "",
        "nix": "",
        "hs": "",
        "swift": "",
        "cs": "󰌛",
